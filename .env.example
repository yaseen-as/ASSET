# ─── Database ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swing_platform
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Redis ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production-min-32-chars!!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Broker (Angel One) ────────────────────────────
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
ANGEL_ONE_API_KEY=your-angel-one-api-key

# ─── Email (Mailtrap for dev) ──────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@swingplatform.dev

# ─── Service Ports ──────────────────────────────────
# API Gateway:         3000
# Auth Service:        3001
# User Service:        3002
# Broker Service:      3003
# Market Data Service: 3004  (WS: 3014)
# Portfolio Service:   3005
# Recommendation Svc:  3006
# Alert Service:       3007
# Notification Svc:    3008  (WS: 3018)
