# api-gateway — port 3000
# JWT verify + tiered rate limit + reverse-proxy to core-service and
# insights-service. Stateless, doesn't talk to Postgres.

# ─── Process ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── JWT (must match core-service JWT_SECRET) ─────────────────────────
JWT_SECRET=dev-secret-change-in-production-min-32-chars
# Optional: set to use RS256 with a public key file instead of HS256.
# JWT_PUBLIC_KEY_PATH=./keys/public.pem

# ─── Redis (rate limit counters) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Upstream services ────────────────────────────────────────────────
CORE_SERVICE_URL=http://localhost:3001
INSIGHTS_SERVICE_URL=http://localhost:3004

# ─── Rate limiting (default tier) ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Unset = allow all (dev).
# CORS_ORIGIN=http://localhost:5173,https://app.example.com
