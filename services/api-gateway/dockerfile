# ── Production image for api-gateway ─────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# Copy monorepo root + shared packages first (better layer caching)
COPY package.json package-lock.json turbo.json ./
COPY packages/ ./packages/
COPY services/api-gateway/ ./services/api-gateway/

# Install ALL workspace deps (includes shared package)
RUN npm ci --workspace=services/api-gateway --include-workspace-root

# Build TypeScript
WORKDIR /app/services/api-gateway
RUN npm run build

# ── Lean runtime image ────────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app/services/api-gateway

COPY --from=builder /app/services/api-gateway/dist ./dist
COPY --from=builder /app/services/api-gateway/package.json ./
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages /app/packages

EXPOSE 3000
CMD ["node", "dist/server.js"]
