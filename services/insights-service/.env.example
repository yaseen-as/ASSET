# insights-service — HTTP pod on port 3004, plus the worker pod (no port).
# market + features + recommendations + backtest + model registry.
# Uses insights_db in Postgres.
#
# Same image runs as two Deployments — the HTTP pod (server.ts) and the
# worker pod (worker.ts) read this same file. Cron flags below are picked
# up by both, but only worker.ts ever calls `cron.start()`.

# ─── Process ──────────────────────────────────────────────────────────
PORT=3004
NODE_ENV=development
LOG_LEVEL=info

# ─── Database (insights_db) ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insights_db
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Redis (BullMQ queue + pub/sub) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Service URLs ─────────────────────────────────────────────────────
CORE_SERVICE_URL=http://localhost:3001

# ─── Feature store materialization (worker pod only) ──────────────────
# Local hour of day (0-23) when the cron fires.
MATERIALIZATION_HOUR=0
# "true" enables the cron on whichever pod reads this var.
# In practice: set "true" only on the worker; the HTTP pod ignores it.
MATERIALIZATION_CRON_ENABLED=false
FEATURE_CACHE_TTL_SECONDS=86400

# ─── ML inference (both pods) ─────────────────────────────────────────
DEFAULT_MODEL_NAME=meta
# LRU cache size for loaded ONNX sessions. Each model ~50MB resident.
MODEL_CACHE_SIZE=5

# ─── ML batch crons (worker pod only) ─────────────────────────────────
DAILY_RANKING_CRON_ENABLED=false
PERFORMANCE_BACKFILL_CRON_ENABLED=false

# ─── Backtest BullMQ queue ────────────────────────────────────────────
BACKTEST_QUEUE_NAME=backtest-runs
# Max simultaneous backtest jobs per worker pod. Start at 1 — backtests
# are CPU-heavy and one OOM can take down all in-flight jobs.
BACKTEST_CONCURRENCY=1
