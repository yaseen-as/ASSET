# ── Production image for alert-service ───────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json turbo.json ./
COPY packages/ ./packages/
COPY services/alert-service/ ./services/alert-service/

RUN npm ci --workspace=services/alert-service --include-workspace-root

WORKDIR /app/services/alert-service
RUN npm run build

# ── Lean runtime image ────────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app/services/alert-service

COPY --from=builder /app/services/alert-service/dist ./dist
COPY --from=builder /app/services/alert-service/package.json ./
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages /app/packages

EXPOSE 3007
CMD ["node", "dist/server.js"]
