PORT=3005
NODE_ENV=development
SERVICE_NAME=recommendation-service

DB_HOST=localhost
DB_PORT=5432
DB_NAME=insights_db
DB_USER=admin
DB_PASSWORD=admin123

REDIS_URL=redis://localhost:6379

FEATURE_SERVICE_URL=http://localhost:3006

# Active model versions are selected from model_registry by name + status.
# "meta" combines technical/fundamental/sentiment via the registered meta model.
# If no meta model is registered, falls back to technical-only.
DEFAULT_MODEL_NAME=meta

MODEL_CACHE_SIZE=5
DAILY_RANKING_CRON_ENABLED=false
PERFORMANCE_BACKFILL_CRON_ENABLED=false
