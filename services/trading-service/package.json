    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.0",
    "knex": "^3.1.0",
    "pg": "^8.13.0",
    "uuid": "^11.0.0",
    "winston": "^3.17.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0"
