# ── Production image for broker-service ──────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json turbo.json ./
COPY packages/ ./packages/
COPY services/broker-service/ ./services/broker-service/

RUN npm ci --workspace=services/broker-service --include-workspace-root

WORKDIR /app/services/broker-service
RUN npm run build

# ── Lean runtime image ────────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app/services/broker-service

COPY --from=builder /app/services/broker-service/dist ./dist
COPY --from=builder /app/services/broker-service/package.json ./
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages /app/packages

EXPOSE 3003
CMD ["node", "dist/server.js"]
