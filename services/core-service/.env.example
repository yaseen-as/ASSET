# core-service — port 3001
# auth + users + broker (Upstox) + portfolio + engagement (alerts/notifications)
# Uses core_db in Postgres.
#
# Copy to `.env` and customize. Everything below is what the code in
# src/config/index.ts reads via process.env; remove anything you're
# happy to leave at its in-code default.

# ─── Process ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info                          # shared logger; debug|info|warn|error

# ─── Database (core_db) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=core_db
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (must match api-gateway JWT_SECRET) ──────────────────────────
JWT_SECRET=dev-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=24h

# ─── Service URLs ─────────────────────────────────────────────────────
INSIGHTS_SERVICE_URL=http://localhost:3004
# Frontend redirect target after Upstox OAuth completes (broker.controller).
FRONTEND_URL=http://localhost:5173

# ─── Broker (Upstox OAuth) ────────────────────────────────────────────
# REQUIRED in production: 32-byte hex for AES-256 encryption of stored
# access tokens. Generate with: openssl rand -hex 32
BROKER_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Upstox OAuth app credentials — register at https://account.upstox.com/developer
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/v1/broker/callback/upstox

# ─── OTP (registration / login) ───────────────────────────────────────
# Provider: 'mock' (dev — OTP is logged to stdout) or a real SMS gateway.
OTP_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=

# ─── Engagement (alerts) ──────────────────────────────────────────────
# Cooldown between consecutive triggers of the same alert (ms).
ALERT_COOLDOWN_MS=300000
# Max total triggers per alert; 0 = unlimited.
ALERT_MAX_TRIGGERS=0
