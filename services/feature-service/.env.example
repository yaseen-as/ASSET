PORT=3006
NODE_ENV=development
SERVICE_NAME=feature-service

DB_HOST=localhost
DB_PORT=5432
DB_NAME=insights_db
DB_USER=admin
DB_PASSWORD=admin123

REDIS_URL=redis://localhost:6379

# Daily materialization fires at this local hour (24h). 0 = midnight.
MATERIALIZATION_HOUR=0
MATERIALIZATION_CRON_ENABLED=false

# Feature cache (24h TTL by default)
FEATURE_CACHE_TTL_SECONDS=86400
