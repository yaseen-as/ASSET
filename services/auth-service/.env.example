# Auth Service
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asset_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=auth

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379

# OTP (SMS provider - e.g., MSG91 / Twilio)
OTP_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
