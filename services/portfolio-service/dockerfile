# ── Production image for portfolio-service ────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json turbo.json ./
COPY packages/ ./packages/
COPY services/portfolio-service/ ./services/portfolio-service/

RUN npm ci --workspace=services/portfolio-service --include-workspace-root

WORKDIR /app/services/portfolio-service
RUN npm run build

# ── Lean runtime image ────────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app/services/portfolio-service

COPY --from=builder /app/services/portfolio-service/dist ./dist
COPY --from=builder /app/services/portfolio-service/package.json ./
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages /app/packages

EXPOSE 3005
CMD ["node", "dist/server.js"]
