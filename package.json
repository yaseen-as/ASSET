{
  "name": "asset-management-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Swing Trade Asset & Recommendation Platform",
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "gateway": "npm run dev --workspace=services/api-gateway",
    "core": "npm run dev --workspace=services/core-service",
    "insights": "npm run dev --workspace=services/insights-service",
    "backtest": "npm run dev --workspace=services/backtest-service",
    "web": "npm run dev --workspace=frontend"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.0.0"
}
